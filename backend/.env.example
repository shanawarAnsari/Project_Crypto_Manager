PORT=4000
DATABASE_PATH=./data/bot.sqlite
# Select exactly one account: testnet = Demo; production = Live.
DELTA_ENV=testnet
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
DELTA_LIVE_API_KEY=
DELTA_LIVE_API_SECRET=
# Legacy fallback, used only when all four environment-specific credential values are empty.
DELTA_API_KEY=
DELTA_API_SECRET=

# IPv4 pins Delta API traffic so the API key's IP whitelist (usually your IPv4) matches. Use auto to allow IPv6.
DELTA_IP_FAMILY=4
# Optional; default is 84 for Demo and 27 for Live.
DELTA_PRODUCT_ID=
# Required for DELTA_ENV=production order placement; set to exactly I_UNDERSTAND_REAL_MONEY.
LIVE_TRADING_CONFIRMED=
MAX_LEVERAGE=2
# Demo allows explicit MAX_LEVERAGE up to 100; Live stays <=2. Lower saved caps remain.
# Demo daily cap is 50% of start-of-day capital, still bounded by MAX_DAILY_LOSS.
# DAILY_LOSS_PERCENT controls the legacy Live policy only.
DAILY_LOSS_PERCENT=2
MAX_DAILY_LOSS=1000
NVIDIA_NIM_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Liquidity Sweep desk (backend/src/desk). Empty ANALYST_* values fall back to the NVIDIA settings.
DESK_INSTRUMENTS=BTCUSD,ETHUSD
# Synthetic data is opt-in. Live market data and account reads do not unlock trading.
DESK_DEMO_MODE=false
# paper is the safe default; delta sends risk-approved orders to the testnet Demo account only.
DESK_EXECUTION=paper
DESK_DEMO_CYCLE_SECONDS=3
DESK_STARTING_BALANCE=10000
DESK_MAX_LEVERAGE=25
ANALYST_API_KEY=
ANALYST_BASE_URL=
ANALYST_MODEL=
