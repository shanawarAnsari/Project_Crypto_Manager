{
  "name": "@sunny/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Crypto Manager liquidity-sweep desk backend for Delta Exchange India",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/desk-server.ts",
    "dev:legacy": "tsx watch src/server.ts",
    "start": "node dist/src/desk-server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "openai": "^5.12.2",
    "technicalindicators": "^3.1.0",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
