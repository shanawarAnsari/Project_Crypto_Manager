{
  "name": "sunny-crypto-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Risk-first automated trading system for Delta Exchange India",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @sunny/db generate",
    "db:migrate": "pnpm --filter @sunny/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @sunny/db migrate:dev",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=100",
    "compose:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml watch",
    "backup:now": "docker compose run --rm backup once",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,prisma}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
