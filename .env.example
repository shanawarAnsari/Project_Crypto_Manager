NVIDIA_API_KEY=

# testnet selects Delta Demo; production selects the real-money Live account.
DELTA_ENV=testnet
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
DELTA_LIVE_API_KEY=
DELTA_LIVE_API_SECRET=

# Legacy fallback, used only when all four environment-specific credential values are empty.
DELTA_API_KEY=
DELTA_API_SECRET=

# IPv4 pins Delta API traffic so the API key's IP whitelist (usually your IPv4) matches. Use auto to allow IPv6.
DELTA_IP_FAMILY=4

# Optional. Defaults: 84 for Demo, 27 for Live.
DELTA_PRODUCT_ID=
# Required for automated order placement with DELTA_ENV=production.
LIVE_TRADING_CONFIRMED=

MAX_LEVERAGE=2
# Default remains 2; Demo permits an explicit value up to 100. Live is still capped at 2.
# Saved lower leverage limits are preserved independently.
DAILY_LOSS_PERCENT=2
# Demo uses the owner-approved 50% daily cap; DAILY_LOSS_PERCENT is the legacy Live setting.
MAX_DAILY_LOSS=1000

# Liquidity Sweep desk (backend/src/desk). Empty ANALYST_* values fall back to the NVIDIA settings.
DESK_INSTRUMENTS=BTCUSD,ETHUSD
# Synthetic data is opt-in. Live market data and account reads do not unlock trading.
DESK_DEMO_MODE=false
# paper is the safe default; delta sends risk-approved orders to the testnet Demo account only.
DESK_EXECUTION=paper
DESK_DEMO_CYCLE_SECONDS=3
DESK_STARTING_BALANCE=10000
DESK_MAX_LEVERAGE=25
ANALYST_API_KEY=
ANALYST_BASE_URL=
ANALYST_MODEL=
