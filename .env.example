# Copy to .env.testnet (laptop/dev) — real env files are git-ignored. Never commit secrets.
# .env.live exists ONLY on the VPS and never on the laptop.

# --- runtime -----------------------------------------------------------------
NODE_ENV=production
APP_ENV=testnet            # testnet | live   (live is refused on the laptop)
TRADING_MODE=PAPER         # PAPER by default; LIVE is rejected unless APP_ENV=live
LOG_LEVEL=info

# --- database ----------------------------------------------------------------
POSTGRES_USER=sunny
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sunny
# Inside compose the host is `postgres`; from the host machine use 127.0.0.1:5432
DATABASE_URL=postgresql://sunny:change-me-local-only@postgres:5432/sunny?schema=public

# --- engine ------------------------------------------------------------------
HEALTH_PORT=8081
HEARTBEAT_INTERVAL_MS=5000
LOCK_TTL_MS=30000
# Web shows a stale banner when the heartbeat is older than this
STALE_HEARTBEAT_MS=20000

# --- exchange (used from Prompt 2) --------------------------------------------
# Delta Exchange INDIA only. The Global URL (api.delta.exchange) is refused.
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=

# --- telegram (used from Prompt 5) --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- backup ------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=14
