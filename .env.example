# Default desk: Delta Exchange India Demo. Do not put real-money keys here.
DELTA_ENV=testnet
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
DELTA_IP_FAMILY=4
DESK_INSTRUMENTS=BTCUSD,ETHUSD
# disabled = observe; delta = permit explicit arming through Settings after restart.
DESK_EXECUTION=disabled
DESK_MAX_LEVERAGE=2
# Initial simulated capital for historical comparisons only; NEVER a wallet fallback.
DESK_STARTING_BALANCE=10000
